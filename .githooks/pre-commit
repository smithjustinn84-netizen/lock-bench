#!/bin/sh
# Runs Spotless (ktlint) before a commit that touches Kotlin, and stops the commit if any Kotlin
# file is off. Fix with ./gradlew spotlessApply, then stage again. Skip once with --no-verify.
#
# Spotless checks the working tree, not just what is staged: an unstaged, misformatted edit
# elsewhere will stop the commit too. (Its spotlessFiles filter does not apply to spotlessCheck.)
#
# Turn it on once per clone: git config core.hooksPath .githooks

root=$(git rev-parse --show-toplevel) || exit 1
staged=$(git diff --cached --name-only --diff-filter=ACMR -- '*.kt' '*.kts')
[ -z "$staged" ] && exit 0

echo "pre-commit: spotlessCheck"
if ! "$root/gradlew" -p "$root" -q spotlessCheck; then
  echo "pre-commit: formatting is off. Run ./gradlew spotlessApply, stage the result and commit again." >&2
  exit 1
fi
